# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# ============================================================================
# MODE 1 — Full pipeline (backend/app.py): runs the real fine-tuned models
# locally. Needs a CUDA GPU (developed/tested on Kaggle's dual T4 GPUs).
# ============================================================================

# Hugging Face token with read access + accepted licenses for:
#   meta-llama/Meta-Llama-3-8B and meta-llama/Llama-3.2-3B-Instruct
HF_TOKEN=

# Optional overrides — defaults match this project's trained models/paths.
# BERT_MODEL_NAME=bert-base-uncased
# CLASSIFIER_LLAMA_MODEL=meta-llama/Meta-Llama-3-8B
# EXPLAINER_BASE_MODEL=meta-llama/Llama-3.2-3B-Instruct
# EXPLAINER_ADAPTER_REPO=kovidritesh/Llama-3.2-3B-FineTuned
# CLASSIFIER_WEIGHTS_PATH=./models/classifier/ft_model_HDFS
# HDFS_LOG_PATH=./data/raw/HDFS.log

# Required only if exposing the server via ngrok (e.g. from Kaggle/Colab,
# which have no public IP). Get a token from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-reserved-domain.ngrok-free.app

# ============================================================================
# MODE 2 — Lite / API-key backend (backend/app_lite.py): no GPU needed, calls
# a hosted LLM to do classification + explanation in one shot. Used for demos.
# ============================================================================

# Which provider to use: "gemini" (default) or "openai_compatible"
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI-compatible (OpenRouter / Groq / OpenAI / etc.) ---
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# Dataset generation (backend/data_pipeline/generate_explanations_llm.py)
# Used once, offline, to build the explainer's fine-tuning dataset.
# ============================================================================
OPENROUTER_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
